ASW_EMAIL=
ASW_PASSWORD=
ASW_BASE_URL=https://blocks.asw.edu.co/api/student/
TZ_LOCAL=America/Bogota

# Preferencias de reserva
TARGET_HOURS=07:30:00,09:00:00,10:30:00 # en orden de prioridad
TARGET_WEEKDAYS=1,2,3,4,5               # 1=lunes … 7=domingo
MAX_CLASSES_PER_DAY=3                   # tope de ASW: 5
ALLOW_SECOND_OPTION=false

# Ventana de apertura
PRE_WINDOW_SECONDS=180                  # cuándo empezar a preparar
POLL_INTERVAL_MS=400
POLL_START_OFFSET_MS=-3000              # empezar a sondear 3 s antes de T
WINDOW_TIMEOUT_SECONDS=60

# Modo
DRY_RUN=true                            # true: nunca llama a agendar en la API real

# Notificaciones (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
